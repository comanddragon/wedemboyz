# Production environment template. Never put real credentials in this file.
# Copy to the ignored `.env.production`, or import into your hosting provider.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
INTERNAL_JOBS_SECRET=replace-with-a-different-long-random-value
DJANGO_ALLOWED_HOSTS=api.wedemboyz.ntsemancho.online
CORS_ALLOWED_ORIGINS=https://wedemboyz.ntsemancho.online
CSRF_TRUSTED_ORIGINS=https://wedemboyz.ntsemancho.online
FRONTEND_URL=https://wedemboyz.ntsemancho.online

# --- Database (Neon) ---
# Paste the connection string from the Neon dashboard (use the pooled "-pooler" host).
# sslmode=require is already part of Neon's string, so DB_SSLMODE is not needed.
DB_URL='postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require'
DB_CONN_MAX_AGE=60

# --- Redis ---
REDIS_URL=rediss://default:PASSWORD@your-redis-host:6379/0

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Cloudflare R2 media ---
AWS_ACCESS_KEY_ID=replace-with-r2-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
AWS_STORAGE_BUCKET_NAME=wedemboyz-media
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_S3_CUSTOM_DOMAIN=media.example.com

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_ESSENTIEL=
STRIPE_PRICE_ID_CONFORT=
STRIPE_PRICE_ID_FAMILLE=

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.paypal.com
PAYPAL_XAF_TO_USD_RATE=605
PAYPAL_PLAN_ID_ESSENTIEL=
PAYPAL_PLAN_ID_CONFORT=
PAYPAL_PLAN_ID_FAMILLE=

# --- CamPay ---
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
CAMPAY_ENVIRONMENT=PROD
CAMPAY_WEBHOOK_KEY=

# --- SMS / WhatsApp / Push ---
SMS_PROVIDER=africastalking
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
WHATSAPP_PROVIDER=twilio
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_FROM_NUMBER=whatsapp:+14155238886
FCM_SERVER_KEY=

# --- Email (Resend) ---
# RESEND_FROM must use a sender/domain verified in your Resend account.
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM=Wedemboyz <notifications@your-verified-domain.com>

# --- Jobs ---
JOBS_BATCH_SIZE=25
JOBS_TIME_BUDGET_SECONDS=20

# --- Sentry ---
SENTRY_DSN=
