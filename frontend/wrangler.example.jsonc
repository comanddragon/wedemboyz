{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wedemboyz-lavomatique",
  "main": "custom-worker.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "upload_source_maps": true,
  "routes": [
    {
      "pattern": "wedemboyz-lavomatique.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXT_PUBLIC_API_BASE_URL": "https://api.wedemboyz-lavomatique.com/api/v1",
    "NEXT_PUBLIC_WS_BASE_URL": "wss://api.wedemboyz-lavomatique.com",
    "INTERNAL_JOBS_URL": "https://api.wedemboyz-lavomatique.com/internal/jobs/run"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
