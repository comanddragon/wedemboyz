# Cloudflare static-assets headers. The worker and manifest must always be
# revalidated so a deploy reaches installed PWAs immediately.
/push-worker.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
/offline.html
  Cache-Control: no-cache
