{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "CLOUDFLARE_ACCOUNT_ID=63ad8f7a09a0e810e0b56974d94ba483 opennextjs-cloudflare build && CLOUDFLARE_ACCOUNT_ID=63ad8f7a09a0e810e0b56974d94ba483 opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "tsc": "bun x tsc --noEmit",
    "lint": "bun --bun eslint ."
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
